---
import { loadPortfolioContent } from '../lib/portfolioContent.js';
import SiteLayout from '../layouts/SiteLayout.astro';
import TechTags from '../components/TechTags.jsx';
import { Github } from 'lucide-react';

const { projects } = await loadPortfolioContent();
const featuredProjects = projects.slice(0, 5);
const remainingProjects = projects.slice(5);
---

<SiteLayout
  title="Projects | Prom Sereyreaksa"
  description="Selected work by Prom Sereyreaksa across software engineering, security tooling, education, and product development."
  canonical="https://promsereyreaksa.dev/projects/"
  currentPath="/projects/"
>
  <section class="page-header shell">
    <div data-reveal>
      <p class="eyebrow">Projects</p>
      <h1 class="page-title">Case studies, products, and focused experiments.</h1>
      <p class="page-lead">
        A selection of work across product engineering, security-minded tooling, educational
        software, and content-led web experiences.
      </p>
    </div>
  </section>

  <div class="shell divider"></div>

  <section class="section shell">
    <div class="project-list">
      {featuredProjects.map((project) => (
        <div class="project-line" data-reveal>
          <a class="project-main-link" href={`/projects/${project.slug}/`}>
            <div class="project-meta">
              <div class="meta-row">
                <span>{project.year}</span>
                <span>{project.role}</span>
              </div>
            </div>
            <h2 class="project-title">{project.title}</h2>
            <div class="project-body">
              <p>{project.summary}</p>
              <TechTags stack={project.stack} max={8} />
            </div>
          </a>
          {project.github ? (
            <a class="project-repo" href={project.github} target="_blank" rel="noreferrer">
              <Github size={14} aria-hidden="true" />
              GitHub
            </a>
          ) : null}
        </div>
      ))}
      {remainingProjects.length ? (
        <details class="project-load-more">
          <summary>Load more projects</summary>
          <div class="project-list project-list--additional">
            {remainingProjects.map((project) => (
              <div class="project-line" data-reveal>
                <a class="project-main-link" href={`/projects/${project.slug}/`}>
                  <div class="project-meta">
                    <div class="meta-row">
                      <span>{project.year}</span>
                      <span>{project.role}</span>
                    </div>
                  </div>
                  <h2 class="project-title">{project.title}</h2>
                  <div class="project-body">
                    <p>{project.summary}</p>
                    <TechTags stack={project.stack} max={8} />
                  </div>
                </a>
                {project.github ? (
                  <a class="project-repo" href={project.github} target="_blank" rel="noreferrer">
                    <Github size={14} aria-hidden="true" />
                    GitHub
                  </a>
                ) : null}
              </div>
            ))}
          </div>
        </details>
      ) : null}
    </div>
  </section>

  <style>
    .project-list {
      display: grid;
      gap: 0;
    }

    .project-line {
      display: grid;
      gap: 0.65rem;
      padding: 1.35rem 0;
      border-top: 1px solid var(--border);
    }

    .project-main-link {
      display: grid;
      grid-template-columns: minmax(10rem, 0.22fr) minmax(11rem, 0.24fr) minmax(0, 0.54fr);
      gap: 1rem 2rem;
      min-width: 0;
      color: inherit;
      text-decoration: none;
    }

    .project-meta {
      min-width: 0;
    }

    .project-repo {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      width: fit-content;
      margin-left: auto;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
    }

    .project-repo:hover {
      color: var(--text);
    }

    .project-list--additional {
      margin-top: 0.75rem;
    }

    .project-load-more {
      margin-top: 1rem;
    }

    .project-load-more summary {
      width: fit-content;
      cursor: pointer;
      color: var(--muted);
      font-size: 0.86rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .project-load-more[open] > summary {
      display: none;
    }

    .project-body {
      display: grid;
      gap: 0.55rem;
    }

    .project-title {
      font-size: 1.55rem;
      font-weight: 550;
      line-height: 1.1;
      margin: 0;
    }

    .project-body p {
      margin: 0;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    @media (max-width: 760px) {
      .project-main-link {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }

      .project-title {
        font-size: 1.3rem;
      }
    }
  </style>
</SiteLayout>
